# Production configuration template.
#
# Copy to `.env`, replace every `change-me` value with a unique secret, and
# keep the resulting file outside version control. `.env.test` is separate:
# it contains disposable test-database credentials only.

POSTGRES_DB=appdb
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5434

API_KEY=change-me-use-a-long-random-api-key
APP_TIMEZONE=Europe/Berlin

# Required only when docker-compose.yml includes the Named-Tunnel service.
CLOUDFLARE_TUNNEL_TOKEN=
